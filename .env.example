# Copy this file to .env.local and fill in real values for local development.
# .env.local (and any .env*.local file) is gitignored — never commit real values.
#
# In Vercel: Project Settings -> Environment Variables. Set values separately per
# environment (Production / Preview / Development) so preview deployments can point
# at different resources (e.g. a staging API) than production.

# Base URL for the backend API that will eventually back /agents and /runs once a
# later assignment wires them up. Not used yet — /health is the only screen that
# fetches real data so far, and it talks to this app's own /api/health route, so it
# doesn't need this variable.
# NEXT_PUBLIC_ prefix makes a value readable from the browser bundle — only use that
# prefix for values that are safe to expose client-side. Anything actually secret
# (an API key, a signing secret) stays unprefixed so it's server-only.
NEXT_PUBLIC_API_BASE_URL=
