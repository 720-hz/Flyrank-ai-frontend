# Copy this file to .env.local and fill in real values for local development.
# .env.local (and any .env*.local file) is gitignored — never commit real values.
#
# In Vercel: Project Settings -> Environment Variables. Set values separately per
# environment (Production / Preview / Development) so preview deployments can point
# at different resources (e.g. a staging API) than production.

# Base URL for a backend API that would back /runs once a later assignment wires it up.
# Not used yet — /health and /agents/[id] are the only screens with real data so far, and
# neither needs this (health talks to this app's own /api/health route; the agent chat
# talks directly to Claude via ANTHROPIC_API_KEY below, server-side).
# NEXT_PUBLIC_ prefix makes a value readable from the browser bundle — only use that
# prefix for values that are safe to expose client-side. Anything actually secret
# (an API key, a signing secret) stays unprefixed so it's server-only.
NEXT_PUBLIC_API_BASE_URL=

# Required for the streaming agent chat at /agents/[id] (FE-06) — the AI SDK's Anthropic
# provider reads this automatically; it's never read client-side and never sent to the
# browser (see src/lib/ai/config.ts and src/app/api/agents/[id]/chat/route.ts). Get a key
# from https://console.anthropic.com/settings/keys. Without it, the chat UI still renders
# and the request/response/error-handling cycle still works — the route handler and
# useChat() both surface a clean error instead of crashing — but you won't get real
# streamed replies.
ANTHROPIC_API_KEY=

# Optional: override the model id without touching code. Defaults to claude-sonnet-4-5
# (see src/lib/ai/config.ts) if unset.
ANTHROPIC_MODEL_ID=
